<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher's reading face: Inter, SIL Open Font License 1.1. The licence text ships in
    the app (assets/licences/inter-ofl-1.1.txt) and is named in About. Everything a person
    reads is set in this; JetBrains Mono (@font/nvf_mono) is kept for technical values alone.
    Framework font resources arrived in API 26 and minSdk is 26, so this needs no library.
    Two weights only; headings differ by size, letter spacing and colour, never by a family.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/inter_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/inter_semibold"
        android:fontStyle="normal"
        android:fontWeight="700" />
</font-family>
