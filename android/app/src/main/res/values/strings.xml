    <!-- Advanced, reached by a long press on the version or the Settings row. -->
    <string name="debug_title">Advanced</string>
    <string name="debug_first_confirm">These switches exist to make the game fail in a known way, so a crash can be reported. They make the game slower and some will stop it loading. Nothing here touches your saves or your game files.</string>
    <string name="debug_open">Open</string>
